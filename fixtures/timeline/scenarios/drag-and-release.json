  "actions": [
    {
      "at": 0,
      "type": "pointerDown",
      "point": {
        "space": "target-fraction",
        "target": "handle",
        "x": 0.5,
        "y": 0.5
      },
      "note": "press the handle"
    },
    {
      "at": 200,
      "type": "pointerMove",
      "point": {
        "space": "target-fraction",
        "target": "track",
        "x": 0.62,
        "y": 0.5
      },
      "note": "drag"
    },
    {
      "at": 400,
      "type": "pointerUp",
      "note": "release"
    }
  ],
  "cleanup": []
}
