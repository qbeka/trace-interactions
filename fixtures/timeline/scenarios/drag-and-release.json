{
  "schema": "trace.scenario/1",
  "id": "drag-and-release",
  "description": "Drag and release normally.",
  "fixture": {
    "id": "timeline",
    "version": "1"
  },
  "seed": 22,
  "initialState": {},
  "viewport": {
    "width": 900,
    "height": 420,
    "deviceScaleFactor": 1
  },
  "timing": {
    "mode": "controlled",
    "stepMs": 16,
    "settleMs": 500
  },
  "targets": {
    "handle": {
      "role": "slider",
      "name": "Playhead",
      "traceId": "handle"
    },
    "track": {
      "traceId": "track"
