{
  "schema": "trace.scenario/1",
  "id": "cancel-drag",
  "description": "Cancel a drag partway through.",
  "fixture": {
    "id": "timeline",
    "version": "1"
  },
  "seed": 21,
  "initialState": {},
  "viewport": {
    "width": 900,
    "height": 420,
    "deviceScaleFactor": 1
  },
  "timing": {
    "mode": "controlled",
    "stepMs": 16,
    "settleMs": 500
  },
  "targets": {
    "handle": {
      "role": "slider",
      "name": "Playhead",
      "traceId": "handle"
    },
    "track": {
      "traceId": "track"
    }
  },
  "requirements": [
    {
      "kind": "transient-cleared",
      "after": "pointerCancel",
      "state": {
        "dragging": false,
        "value": 30
      }
    },
    {
      "kind": "geometry-continuous",
      "target": "handle",
      "maxStepPx": 600
    }
  ],
  "actions": [
    {
      "at": 0,
      "type": "pointerDown",
      "point": {
        "space": "target-fraction",
        "target": "handle",
        "x": 0.5,
        "y": 0.5
      },
      "note": "press the handle",
      "ack": {
        "key": "dragging",
        "equals": true,
        "withinMs": 50
      }
    },
    {
      "at": 200,
      "type": "pointerMove",
      "point": {
        "space": "target-fraction",
        "target": "track",
        "x": 0.5,
        "y": 0.5
      },
      "note": "drag to the middle"
    },
    {
      "at": 400,
      "type": "pointerMove",
      "point": {
        "space": "target-fraction",
        "target": "track",
        "x": 0.8,
        "y": 0.5
      },
      "note": "drag further"
    },
    {
      "at": 600,
      "type": "pointerCancel",
      "note": "the browser cancels the gesture"
    }
  ],
  "cleanup": []
}
