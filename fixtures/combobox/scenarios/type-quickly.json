{
  "schema": "trace.scenario/1",
  "id": "type-quickly",
  "description": "Type a query with pauses, so an early response answers after a later one.",
  "fixture": {
    "id": "combobox",
    "version": "1"
  },
  "seed": 31,
  "initialState": {},
  "viewport": {
    "width": 900,
    "height": 640,
    "deviceScaleFactor": 1
  },
  "timing": {
    "mode": "controlled",
    "stepMs": 16,
    "settleMs": 800
  },
  "targets": {
    "input": {
      "role": "combobox",
      "name": "Search fruit",
      "traceId": "input"
    },
    "list": {
      "traceId": "list"
    }
  },
  "requirements": [
    {
      "kind": "latest-request-wins",
      "key": "resultsFor",
      "terminal": [
        "a",
        "ap",
        "app"
      ]
    },
    {
      "kind": "focus-stays-on",
      "target": "input",
      "whileState": {
        "listbox": "open"
      }
    },
    {
      "kind": "focus-valid"
    }
  ],
  "actions": [
    {
      "at": 0,
      "type": "focus",
      "target": "input",
      "note": "focus the search"
    },
    {
      "at": 100,
      "type": "type",
      "target": "input",
      "text": "a",
      "requests": {
        "resultsFor": "a"
      },
      "note": "type a"
    },
    {
      "at": 300,
      "type": "type",
      "target": "input",
      "text": "p",
      "requests": {
        "resultsFor": "ap"
      },
      "note": "type p"
    }
  ],
  "cleanup": []
}
