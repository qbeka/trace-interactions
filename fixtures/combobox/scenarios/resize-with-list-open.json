{
  "schema": "trace.scenario/1",
  "id": "resize-with-list-open",
  "description": "Narrow the window with the list open.",
  "fixture": {
    "id": "combobox",
    "version": "1"
  },
  "seed": 34,
  "initialState": {},
  "viewport": {
    "width": 900,
    "height": 640,
    "deviceScaleFactor": 1
  },
  "timing": {
    "mode": "controlled",
    "stepMs": 16,
    "settleMs": 800
  },
  "targets": {
    "input": {
      "role": "combobox",
      "name": "Search fruit",
      "traceId": "input"
    },
    "list": {
      "traceId": "list"
    }
  },
  "requirements": [
    {
      "kind": "geometry-fits",
      "target": "list",
      "insetPx": 8,
      "tolerancePx": 2
    }
  ],
  "actions": [
    {
      "at": 0,
      "type": "focus",
      "target": "input",
      "note": "focus the search"
    },
    {
      "at": 100,
      "type": "type",
      "target": "input",
      "text": "d",
      "note": "type d"
    },
    {
      "at": 800,
      "type": "resize",
      "width": 360,
      "height": 640,
      "note": "narrow the window"
    }
  ],
  "cleanup": []
}
